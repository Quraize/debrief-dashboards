# Backend image — Node 22 + Fastify (MIGRATION_PLAN.md §10.2).
#
# Build context is the REPO ROOT (the workspaces need the root lockfile):
#   docker build -f deploy/Dockerfile.backend .
#
# Three stages:
#   deps    — every workspace's manifest + a full backend install (dev deps
#             included: tsc for the build, tsx for the tools stage)
#   build   — compiles backend/src -> backend/dist; also the image the `tools`
#             compose service uses for seed-user.ts and other tsx scripts
#   runtime — production deps only, compiled output, non-root, no shell tools

FROM node:22-bookworm-slim AS deps
WORKDIR /app
# All three workspace manifests must be present or `npm ci` refuses the lock.
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY shared/package.json shared/
COPY frontend/package.json frontend/
# --include-workspace-root matters: tsc comes from the ROOT devDependencies,
# and a bare `npm ci --workspace backend` skips those.
RUN npm ci --workspace backend --include-workspace-root

FROM deps AS build
COPY shared ./shared
COPY backend/tsconfig.json backend/
COPY backend/src backend/src
COPY backend/scripts backend/scripts
COPY backend/migrations backend/migrations
RUN npm run build --workspace backend
WORKDIR /app/backend

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY shared/package.json shared/
COPY frontend/package.json frontend/
RUN npm ci --workspace backend --omit=dev && npm cache clean --force
# shared/ is runtime code — the workspace symlink points at it.
COPY shared/src shared/src
COPY --from=build /app/backend/dist backend/dist
# The migration runner resolves ../../migrations relative to dist/db, so the
# SQL ships next to the compiled output. Migrations NEVER run on boot — the
# compose `migrate` service is the explicit, gated step (§10.5).
COPY backend/migrations backend/migrations
# Upload volume mount point, owned by the runtime user before the volume is
# created from it (a root-owned mount would break file uploads).
RUN mkdir -p /data/uploads && chown -R node:node /data/uploads
USER node
WORKDIR /app/backend
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT??3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist/server.js"]
