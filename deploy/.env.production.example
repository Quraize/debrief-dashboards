# Production environment for docker-compose.prod.yml.
#
#   cp deploy/.env.production.example deploy/.env.production
#
# NEVER commit the real file (.gitignore already covers .env.*).
# Generate every password as hex so it is safe inside a connection URL:
#   openssl rand -hex 24

# ── Domain ─────────────────────────────────────────────────────────────────
# The subdomain this app lives on. Create the DNS A record BEFORE first boot —
# Caddy needs it resolvable to obtain the TLS certificate.
#
# No domain yet? HTTPS is still required (production cookies are Secure and
# browsers drop them over plain HTTP). Two interim values that work:
#   <ip-with-dashes>.sslip.io   real Let's Encrypt cert via public wildcard DNS,
#                               e.g. 203-0-113-10.sslip.io  (no browser warnings)
#   https://<VPS-IP>            Caddy self-signs for the IP (one warning per browser)
# Later, switch to the real subdomain and run `deploy/deploy.sh up` — Caddy
# re-issues automatically; users just log in again.
SITE_ADDRESS=sales.example.com

# ── Database credentials (hex only — see note above) ──────────────────────
POSTGRES_DB=allied
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
ALLIED_OWNER_PASSWORD=
ALLIED_APP_PASSWORD=
ALLIED_JOBS_PASSWORD=
# Host-only bind for scripts/backup.sh (127.0.0.1, never public).
POSTGRES_PORT=5432

# ── Image tag (rollback = redeploy the previous tag) ───────────────────────
TAG=latest

# ── JobProgress ────────────────────────────────────────────────────────────
# Generate a FRESH token in Leap (Settings -> Developer) at cutover — rotate
# any token that has ever been shared over chat or held by a third party.
LEAP_API_TOKEN=
LEAP_RATE_LIMIT=55

# ── Scheduled sync ─────────────────────────────────────────────────────────
# Leave false until one clean MANUAL commit run has been verified, then flip.
SYNC_SCHEDULE_ENABLED=false
# UTC by design (DST, §4.3). Default = 11:00/16:00/20:00/23:00 UTC.
SYNC_SCHEDULE_CRON=0 11,16,20,23 * * *

# ── Debrief reminder emails ────────────────────────────────────────────────
# Two hours after a sales appointment starts with no debrief filed here, the
# rep gets one email. Recipients are kept in the app (Admin → Debrief
# Reminders). Stays off until this is true; send a test from that page first.
DEBRIEF_REMINDERS_ENABLED=false
# Google Workspace mailbox that sends. Dedicated account, 2-step verification
# on, App Password generated for "Mail" — paste the 16-character app password,
# never the account password. Both belong ONLY in this file.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults: smtp.gmail.com:465, From = "Allied Debriefs <SMTP_USER>".
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
# Who a rep without an account should ask (named in every email).
DEBRIEF_REMINDER_SUPPORT_CONTACT=IT / Automation Support
# Only appointments ON OR AFTER this date (YYYY-MM-DD, office clock) are ever
# reminded. Set it to the go-live day so the backlog the office is filling by
# hand is never emailed about. Leave empty to consider everything in range.
DEBRIEF_REMINDER_START_DATE=
# Rule knobs (defaults shown): every 15 min; 2h after start; appointments stay
# eligible 14 days; quiet hours 9 PM–7 AM Eastern.
#DEBRIEF_REMINDER_CRON=*/15 * * * *
#DEBRIEF_REMINDER_DELAY_HOURS=2
#DEBRIEF_REMINDER_LOOKBACK_DAYS=14
#DEBRIEF_REMINDER_QUIET_START=21
#DEBRIEF_REMINDER_QUIET_END=7

# ── Pending integrations (Sprint 5 — leave empty until credentials exist) ──
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
ANTHROPIC_API_KEY=

# ── Backups (used by backend/scripts/backup.sh via host cron, not compose) ─
# See DEPLOYMENT.md §7. BACKUP_PASSPHRASE must also live OFF this machine.
