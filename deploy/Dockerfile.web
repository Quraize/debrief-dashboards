# Web image — Caddy serving the built frontend and proxying /api (§10.1/§10.2).
#
# Build context is the REPO ROOT:
#   docker build -f deploy/Dockerfile.web .
#
# The static bundle is baked into the image rather than shared via a volume:
# a deploy is then one immutable artifact, and rollback is `docker compose up`
# with the previous tag — no half-swapped asset directories.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY shared/package.json shared/
COPY frontend/package.json frontend/
RUN npm ci --workspace frontend
COPY shared ./shared
COPY frontend ./frontend
# vite.config.js writes to ../dist, i.e. /app/dist.
RUN npm run build --workspace frontend

FROM caddy:2.8-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
