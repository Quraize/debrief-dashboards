# Copy to .env and fill in. NEVER commit .env.
#
# Nothing here may be prefixed VITE_ - that prefix compiles values into the
# browser bundle. Frontend configuration lives in frontend/.env.

# ── Database ──────────────────────────────────────────────────────────────
# Three roles, three URLs. The request path must use the allied_app URL so that
# RLS applies; only background jobs use allied_jobs (BYPASSRLS).
DATABASE_URL=postgres://allied_owner:CHANGE_ME@127.0.0.1:5432/allied
DATABASE_URL_APP=postgres://allied_app:CHANGE_ME@127.0.0.1:5432/allied
DATABASE_URL_JOBS=postgres://allied_jobs:CHANGE_ME@127.0.0.1:5432/allied
PG_POOL_MAX=10

POSTGRES_DB=allied
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_PORT=5432

# ── Backups (D12: ours to run, and a cutover blocker) ─────────────────────
BACKUP_DIR=/var/backups/allied
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Passphrase for symmetric encryption. Store it OFF this machine as well -
# a backup you cannot decrypt after losing the host is not a backup.
BACKUP_PASSPHRASE=
# Any rclone remote, e.g. s3:allied-backups or b2:allied-backups
BACKUP_REMOTE=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ── Integrations (Sprint 5) ───────────────────────────────────────────────
LEAP_API_TOKEN=
# Override only for stubs/testing; defaults to the real API.
LEAP_API_BASE=
# Requests per minute against the JobProgress API (their hard limit is 60).
LEAP_RATE_LIMIT=55
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
ANTHROPIC_API_KEY=
# Contract price review: model for document reading, and the default
# look-back window over contract_signed_date.
EXTRACTION_MODEL=claude-sonnet-5
PRICE_SCAN_DAYS=5

# ── JobProgress sync scheduling ───────────────────────────────────────────
# Leave disabled until one clean MANUAL commit run has been verified
# (MIGRATION_PLAN.md Sprint 6), then set true.
SYNC_SCHEDULE_ENABLED=false
# UTC on purpose (DST — §4.3). Default fires 11:00/16:00/20:00/23:00 UTC:
# 7a/12p/4p/7p America/New_York in summer, an hour earlier in winter.
SYNC_SCHEDULE_CRON=0 11,16,20,23 * * *
# Bound on an in-request manual sync before the HTTP response gives up
# (the sync itself continues server-side).
SYNC_TIMEOUT_MS=600000
# How long a deploy waits for a running job before failing it into retry.
SYNC_SHUTDOWN_TIMEOUT_MS=20000

# ── Tests ─────────────────────────────────────────────────────────────────
TEST_PG_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
