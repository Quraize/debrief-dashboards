{
  "name": "@allied/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts status",
    "db:down": "tsx src/db/migrate.ts down",
    "db:generate-schema": "tsx scripts/generate-schema.ts",
    "seed:user": "tsx scripts/seed-user.ts"
  },
  "dependencies": {
    "@allied/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "otpauth": "^9.5.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
